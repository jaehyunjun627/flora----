# =============================================
# Flora Backend 환경변수 설정 예시
# 이 파일을 복사해서 .env 파일을 만들고 실제 값을 채우세요.
# .env 파일은 절대 Git에 커밋하지 마세요!
# =============================================

# Spring Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# Oracle DB 설정
# 운영용 전용 계정을 만드세요: CREATE USER flora_app IDENTIFIED BY 강한비밀번호;
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USERNAME=system
DB_PASSWORD=12345

# MongoDB
MONGODB_URI=mongodb://localhost:27017/flora

# JWT Secret (최소 64자 이상의 랜덤 문자열 사용)
# 생성 방법: openssl rand -hex 64
JWT_SECRET=여기에_최소_64자_이상의_랜덤_문자열_입력
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# 외부 API 키
PIXABAY_API_KEY=여기에_Pixabay_API_키_입력
FOREST_API_KEY=여기에_산림청_API_키_입력
OPENAI_API_KEY=여기에_OpenAI_API_키_입력

# 파일 업로드 경로
UPLOAD_DIR=uploads

# JPA DDL (dev: update, prod: validate)
DDL_AUTO=update
